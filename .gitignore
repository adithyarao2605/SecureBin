# Dependencies and local runtimes
node_modules/
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# Build, test, coverage, and framework output
.next/
out/
dist/
build/
coverage/
playwright-report/
test-results/
*.log
*.tsbuildinfo

# Local deployment and database state
.vercel/
.supabase/
supabase/.temp/
supabase/.branches/

# Secrets and machine-local configuration. Keep the names, never values.
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12

# Competition/reference material is read-only and is not submission source.
/info/*
!/info/HANDOFF.md
/info/plan.md
/info/PrivateBin/
